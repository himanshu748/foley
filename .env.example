# Set these in the process environment; the server does not auto-load .env files.
PORT=4331
HOST=127.0.0.1
DATA_PATH=data/foley.sqlite
# Required behind an HTTPS reverse proxy. Sets canonical origin and secure cookies.
# PUBLIC_URL=https://foley.example.com
# Only when one trusted proxy is the sole inbound route (as in compose.yaml).
# TRUST_PROXY=1
# Docker Compose only: bare public hostname, without https:// or a path.
# FOLEY_HOST=foley.example.com

{
  "name": "foley-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:recorder": "node tests/recorder-browser.mjs",
    "test:3d": "node tests/3d-browser.mjs",
    "test:tv": "node tests/tv-browser.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
